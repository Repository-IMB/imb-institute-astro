---
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import MotionController from '../components/ui/MotionController.astro';
import defaultSocialImage from '../assets/images/equipo-trabajo-colaboracion-oficina.webp';
import '../styles/global.css';

type JsonLd = Record<string, unknown>;

export interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'pt';
  canonical?: string | URL;
  image?: string | ImageMetadata;
  imageAlt?: string;
  robots?: string;
  structuredData?: JsonLd | JsonLd[];
}

const {
  title = 'IMB Institute',
  description = 'Cursos para profesionales y organizaciones que buscan aplicar lo aprendido en su trabajo.',
  lang = 'es',
  canonical,
  image = defaultSocialImage,
  imageAlt = title,
  robots,
  structuredData = [],
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical
  ? new URL(canonical, siteUrl)
  : new URL(Astro.url.pathname, siteUrl);
const isProductionDomain = siteUrl.hostname === 'imbinstitute.com';
const robotsContent = robots ?? (
  isProductionDomain
    ? 'index, follow, max-image-preview:large'
    : 'noindex, nofollow'
);
const imageSource = typeof image === 'string' ? image : image.src;
const socialImageUrl = new URL(imageSource, siteUrl);
const socialLocale = lang === 'pt' ? 'pt_BR' : 'es_PE';
const jsonLdItems = Array.isArray(structuredData) ? structuredData : [structuredData];
const serializeJsonLd = (value: JsonLd) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-imb.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IMB Institute" />
    <meta property="og:locale" content={socialLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>

    {jsonLdItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(item)} />
    ))}

    <!-- Google Fonts: Montserrat + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:ital,wght@0,500;0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-surface-50 text-text-primary min-h-screen flex flex-col">
    <!-- Header -->
    <Header />

    <!-- Main Content -->
    <main class="grow">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <MotionController />
  </body>
</html>
