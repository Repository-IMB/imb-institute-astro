<script>
  const revealSelector = '[data-motion-reveal]';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let revealObserver: IntersectionObserver | undefined;

  function showAllSections() {
    document.documentElement.classList.remove('motion-ready');
    document.querySelectorAll(revealSelector).forEach((element) => {
      element.classList.add('is-visible');
    });
  }

  function initializeSectionReveals() {
    revealObserver?.disconnect();

    const sections = Array.from(document.querySelectorAll<HTMLElement>(revealSelector));

    if (
      reducedMotion.matches
      || !('IntersectionObserver' in window)
      || sections.length === 0
    ) {
      showAllSections();
      return;
    }

    revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, {
      threshold: 0.08,
      rootMargin: '0px 0px -8% 0px',
    });

    sections.forEach((section) => {
      const startsInsideViewport = section.getBoundingClientRect().top <= window.innerHeight * 0.92;

      if (startsInsideViewport) {
        section.classList.add('is-visible');
        return;
      }

      revealObserver?.observe(section);
    });

    document.documentElement.classList.add('motion-ready');
  }

  reducedMotion.addEventListener('change', initializeSectionReveals);
  document.addEventListener('astro:page-load', initializeSectionReveals);
  initializeSectionReveals();
</script>
