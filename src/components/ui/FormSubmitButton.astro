---
interface Props {
  id: string;
  label: string;
  fullWidth?: boolean;
  class?: string;
}

const {
  id,
  label,
  fullWidth = true,
  class: className,
} = Astro.props;
---

<button
  id={id}
  type="submit"
  class:list={[
    'inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-md bg-imb px-6 py-3 font-display text-sm font-semibold tracking-wide text-surface-0 shadow-sm transition-colors duration-200 hover:bg-imb-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-imb disabled:cursor-not-allowed disabled:opacity-60',
    fullWidth && 'w-full',
    className,
  ]}
>
  <span class="btn-text">{label}</span>
  <svg class="btn-spinner hidden size-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
  </svg>
</button>
