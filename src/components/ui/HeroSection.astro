---
import Wrapper from './Wrapper.astro';
import MediaImage from './MediaImage.astro';

interface Props {
  title: string;
  highlight?: string;
  description?: string;
  image: any;
  imageAlt?: string;
  class?: string;
}

const {
  title,
  highlight,
  description,
  image,
  imageAlt = '',
  class: className
} = Astro.props;

const highlightIndex = highlight ? title.indexOf(highlight) : -1;
const titleBefore = highlightIndex >= 0 ? title.slice(0, highlightIndex) : title;
const titleAfter = highlightIndex >= 0 && highlight
  ? title.slice(highlightIndex + highlight.length)
  : '';
---

<Wrapper
  class:list={[
    'relative isolate min-h-[460px] overflow-hidden bg-gray-950 py-20 md:min-h-[520px] md:py-24',
    className
  ]}
  padded={false}
  full
>
  <div class="absolute inset-0 -z-20">
    <MediaImage
      src={image}
      alt={imageAlt}
      class="h-full w-full object-cover object-center"
      width={2000}
      height={1125}
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="absolute inset-0 -z-10 bg-gray-950/65"></div>

  <div class="mx-auto flex min-h-[300px] max-w-4xl flex-col items-center justify-center text-center md:min-h-[328px]">
    <h1 class="text-display text-white">
      {highlightIndex >= 0 && highlight ? (
        <>
          {titleBefore}<span class="underline decoration-imb decoration-4 underline-offset-8">{highlight}</span>{titleAfter}
        </>
      ) : title}
    </h1>
    {description && (
      <p class="mt-6 max-w-3xl text-lead text-gray-200">
        {description}
      </p>
    )}
    <slot />
  </div>
</Wrapper>
