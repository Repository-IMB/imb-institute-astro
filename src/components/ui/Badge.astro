---
export interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'success' | 'warning';
  class?: string;
}

const { variant = 'primary', class: className } = Astro.props;

const variantClasses = {
  primary: 'border-imb bg-imb text-white',
  secondary: 'bg-surface-100 text-text-secondary border border-border-subtle',
  outline: 'bg-transparent text-text-primary border border-border-subtle',
  success: 'border-status-active-border bg-status-active-bg text-status-active-text',
  warning: 'border-status-inactive-border bg-status-inactive-bg text-status-inactive-text'
};

const indicatorClasses = {
  success: 'bg-status-active-indicator',
  warning: 'bg-status-inactive-indicator'
};

const indicatorClass = variant === 'success' || variant === 'warning'
  ? indicatorClasses[variant]
  : undefined;
---

<span class:list={[
  "inline-flex min-h-7 items-center gap-2 whitespace-nowrap rounded-full border px-3 py-1 text-label uppercase shadow-sm",
  variantClasses[variant],
  className
]}>
  {indicatorClass && <span class:list={["size-2 shrink-0 rounded-full", indicatorClass]} aria-hidden="true"></span>}
  <slot />
</span>
