---
import { Image } from 'astro:assets';
import defaultPlaceholder from '@assets/images/default-placeholder.avif';

export interface Props {
  src?: any;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  optimizeRemote?: boolean;
  [key: string]: any;
}

const { src, alt, optimizeRemote = false, ...rest } = Astro.props;
const altText = alt ?? "Imagen de IMB Institute";

// Type checks for source
const isEsmImport = src && typeof src === 'object' && 'src' in src;
const isRemoteUrl = typeof src === 'string' && src.startsWith('http');
const isPublicPath = typeof src === 'string' && src.startsWith('/');
const importedFormat = isEsmImport && src.format === 'avif' ? 'avif' : undefined;
const canOptimizeRemote = isRemoteUrl && optimizeRemote && rest.width && rest.height;
const remoteWidth = Number(rest.width);
const remoteHeight = Number(rest.height);
const { widths: _widths, sizes: _sizes, ...htmlImageProps } = rest;

// Fallback logic
---

{isEsmImport && (
  <Image src={src} alt={altText} format={importedFormat} {...rest} />
)}

{canOptimizeRemote && (
  <Image
    src={src}
    alt={altText}
    {...rest}
    width={remoteWidth}
    height={remoteHeight}
  />
)}

{isRemoteUrl && !canOptimizeRemote && (
  <img src={src} alt={altText} {...htmlImageProps} />
)}

{isPublicPath && (
  <img src={src} alt={altText} {...htmlImageProps} />
)}

{!src && (
  <Image src={defaultPlaceholder} alt={altText} {...rest} />
)}
