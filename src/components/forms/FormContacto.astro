---
import InputField from '../ui/InputField.astro';
import PhoneInput from '../ui/PhoneInput.astro';
import FormError from '../ui/FormError.astro';
import FormSubmitButton from '../ui/FormSubmitButton.astro';
import FormSuccess from '../ui/FormSuccess.astro';

export interface Props {
  cursoNombre?: string;
  class?: string;
}

const { cursoNombre, class: className } = Astro.props;
const formId = cursoNombre ? 'form-asesor' : 'form-contacto';
const btnText = cursoNombre ? 'Solicitar información' : 'Enviar mensaje';
---

<div id={`${formId}-wrapper`} class:list={[className]}>
  <!-- Formulario (con method="POST" para fallback sin JS) -->
  <form
    id={formId}
    data-submission-form
    data-action={cursoNombre ? 'asesor' : 'contacto'}
    data-submit-label={btnText}
    data-pending-label="Enviando..."
    data-error-id={`${formId}-error`}
    data-error-message-id={`${formId}-error-msg`}
    data-success-id={`${formId}-success`}
    method="POST"
    class="space-y-8"
    novalidate
  >
    {cursoNombre && <input type="hidden" name="cursoNombre" value={cursoNombre} />}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <InputField label="Nombres" name="nombres" placeholder="María" required />
      <InputField label="Apellidos" name="apellidos" placeholder="Torres" required />
    </div>

    <PhoneInput label="WhatsApp" name="telefono" id={`${formId}-telefono`} required />

    <InputField label="Correo electrónico" name="correo" type="email" placeholder="maria.torres@correo.com" required />

    {!cursoNombre && (
      <InputField label="Consulta" name="consulta" required type="textarea" rows={4} placeholder="Cuéntanos qué programa buscas o cómo podemos ayudarte" />
    )}

    <FormError id={`${formId}-error`} messageId={`${formId}-error-msg`} />

    <div class="pt-4">
      <FormSubmitButton id={`${formId}-btn`} label={btnText} />
    </div>
  </form>

  <FormSuccess id={`${formId}-success`} title="¡Mensaje enviado!">
    <p>
      Hemos recibido tu consulta. Un asesor académico se comunicará contigo en breve.
    </p>
  </FormSuccess>
</div>

<script>
  import '../../scripts/submission-form';
</script>
