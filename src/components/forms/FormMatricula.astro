---
import InputField from '../ui/InputField.astro';
import SelectField from '../ui/SelectField.astro';
import Button from '../ui/Button.astro';
import PhoneInput from '../ui/PhoneInput.astro';
import { cursos } from '../../data/cursos';

const cursoOptions = [
  { value: '', label: 'Selecciona un programa de la lista...' },
  ...cursos.map(c => c.nombre),
];
---

<div id="form-matricula-wrapper">
  <form id="matricula-form" method="POST" class="space-y-8" novalidate>
    <div class="flex items-center justify-between mb-12 relative px-2">
      <div class="absolute left-0 top-1/2 -translate-y-1/2 w-full h-1 bg-gray-200 rounded-full z-0"></div>
      <div id="progress-bar" class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-imb rounded-full z-0 transition-all duration-500" style="width: 0%"></div>
      {[1, 2, 3, 4].map((s) => (
        <div id={`step-circle-${s}`} class={`relative z-10 w-10 h-10 rounded-full flex items-center justify-center font-display font-bold text-sm transition-all duration-300 border-2 ${s === 1 ? 'bg-imb text-white border-imb shadow-md' : 'bg-surface-0 text-gray-400 border-gray-200'}`}>
          <span class="step-number">{s}</span>
          <svg class="step-check hidden w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
      ))}
    </div>

    <div id="step-1" class="step-content space-y-8">
      <h3 class="font-display text-2xl font-bold text-text-primary">Selección de Programa</h3>
      <SelectField label="Curso / Diplomado a matricularse" name="curso" required options={cursoOptions} />
    </div>

    <div id="step-2" class="step-content space-y-8 hidden">
      <h3 class="font-display text-2xl font-bold text-text-primary">Datos Personales</h3>
      <InputField label="Nombres y Apellidos Completos" name="nombres" required placeholder="Ej. Carlos Mendoza" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <InputField label="Tipo y Número de Documento" name="documento" required placeholder="Ej. DNI / Pasaporte" />
        <InputField label="País de Residencia" name="pais" required placeholder="Ej. Perú" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <InputField label="Correo Electrónico" name="correo" type="email" required placeholder="correo@ejemplo.com" />
        <PhoneInput label="Número de WhatsApp" name="whatsapp" id="matricula-whatsapp" required />
      </div>
    </div>

    <div id="step-3" class="step-content space-y-8 hidden">
      <h3 class="font-display text-2xl font-bold text-text-primary">Perfil Profesional</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <InputField label="Área de Formación o Profesión" name="formacion" required placeholder="Ej. Ingeniería Industrial" />
        <InputField label="Empresa Actual (Opcional)" name="empresa" required={false} placeholder="Nombre de la empresa" />
      </div>
      <InputField label="Cargo u Ocupación" name="cargo" required placeholder="Ej. Jefe de Planta" />
      <SelectField label="Familiaridad Tecnológica" name="familiaridad_tecnologica" required options={[ { value: '', label: 'Seleccione su nivel de conocimiento tecnológico...' }, 'Básico (Uso redes sociales, correo)', 'Intermedio (Uso Office, Zoom, plataformas web)', 'Avanzado (Dominio de software especializado)' ]} />
    </div>

    <div id="step-4" class="step-content space-y-8 hidden">
      <h3 class="font-display text-2xl font-bold text-text-primary">Facturación y Complementos</h3>
      <SelectField label="Tipo de Comprobante" name="tipo_comprobante" required options={[ { value: '', label: 'Seleccione el tipo de comprobante que requiere...' }, 'Boleta Electrónica (Personal)', 'Factura Electrónica (Empresa)' ]} />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <InputField label="Razón Social / Nombre a Facturar" name="razon_social" required placeholder="Nombre para la facturación" />
        <InputField label="Número Tributario (RUC/RUT/NIT)" name="numero_tributario" required={false} placeholder="Identificación tributaria" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <InputField label="Nivel actual de Inglés" name="nivel_ingles" required={false} placeholder="Ej. Intermedio" />
        <InputField label="Nivel actual de Excel" name="nivel_excel" required={false} placeholder="Ej. Avanzado" />
      </div>
    </div>

    <div id="form-matricula-error" class="hidden items-start gap-3 p-4 bg-rose-50 border border-rose-100 rounded-xl text-rose-800 text-sm leading-relaxed">
      <svg class="w-5 h-5 shrink-0 mt-0.5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span id="form-matricula-error-msg"></span>
    </div>

    <div class="mt-12 flex justify-between items-center pt-8">
      <div id="btn-back-wrapper" class="hidden">
        <Button type="button" id="btn-back" variant="outline">Regresar</Button>
      </div>
      <div class="grow"></div>
      <div id="btn-next-wrapper">
        <Button type="button" id="btn-next" class="px-10 py-4">Siguiente Paso</Button>
      </div>
      <div id="btn-submit-wrapper" class="hidden">
        <button id="form-matricula-btn" type="submit" class="px-10 py-4 inline-flex items-center justify-center gap-2 rounded-md font-display font-semibold transition-all duration-200 ease-out text-sm tracking-wide cursor-pointer bg-imb text-white hover:bg-imb-hover shadow-sm disabled:opacity-60 disabled:cursor-not-allowed">
          <span class="btn-text">Finalizar Matrícula</span>
          <svg class="btn-spinner hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
        </button>
      </div>
    </div>
  </form>

  <div id="form-matricula-success" class="hidden flex-col items-center text-center py-12 gap-4">
    <div class="w-16 h-16 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center mb-2">
      <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
    </div>
    <h3 class="font-display text-xl font-bold text-text-primary">¡Ficha enviada con éxito!</h3>
    <p class="font-sans text-text-secondary leading-relaxed max-w-sm">
      Hemos recibido tu ficha de matrícula. Un asesor académico se comunicará contigo para confirmar los próximos pasos.
    </p>
  </div>
</div>

<script>
  import { actions, isInputError } from 'astro:actions';

  function initMatricula() {
    const form = document.getElementById('matricula-form') as HTMLFormElement;
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    const totalSteps = 4;
    let currentStep = 1;

    const stepContents = document.querySelectorAll('.step-content');
    const circles = [1, 2, 3, 4].map((i) => document.getElementById(`step-circle-${i}`));
    const progressBar = document.getElementById('progress-bar');
    const btnBack = document.getElementById('btn-back');
    const btnNext = document.getElementById('btn-next');
    const btnBackWrapper = document.getElementById('btn-back-wrapper');
    const btnNextWrapper = document.getElementById('btn-next-wrapper');
    const btnSubmitWrapper = document.getElementById('btn-submit-wrapper');
    
    const errorEl = document.getElementById('form-matricula-error');
    const errorMsg = document.getElementById('form-matricula-error-msg');
    const successEl = document.getElementById('form-matricula-success');
    const btnSubmit = document.getElementById('form-matricula-btn') as HTMLButtonElement;
    const btnText = btnSubmit?.querySelector('.btn-text');
    const btnSpinner = btnSubmit?.querySelector('.btn-spinner');

    function updateWizard() {
      stepContents.forEach((el, i) => { el.classList.toggle('hidden', i + 1 !== currentStep); });
      if (progressBar) progressBar.style.width = `${((currentStep - 1) / (totalSteps - 1)) * 100}%`;
      circles.forEach((circle, i) => {
        const stepNum = i + 1;
        const numEl = circle?.querySelector('.step-number');
        const checkEl = circle?.querySelector('.step-check');
        if (stepNum < currentStep) {
          circle?.classList.remove('bg-surface-0', 'text-gray-400', 'border-gray-200');
          circle?.classList.add('bg-imb', 'text-white', 'border-imb', 'shadow-md');
          numEl?.classList.add('hidden'); checkEl?.classList.remove('hidden');
        } else if (stepNum === currentStep) {
          circle?.classList.remove('bg-surface-0', 'text-gray-400', 'border-gray-200');
          circle?.classList.add('bg-imb', 'text-white', 'border-imb', 'shadow-md');
          numEl?.classList.remove('hidden'); checkEl?.classList.add('hidden');
        } else {
          circle?.classList.remove('bg-imb', 'text-white', 'border-imb', 'shadow-md');
          circle?.classList.add('bg-surface-0', 'text-gray-400', 'border-gray-200');
          numEl?.classList.remove('hidden'); checkEl?.classList.add('hidden');
        }
      });

      // Back button visibility
      if (currentStep === 1) {
        btnBackWrapper?.classList.add('hidden');
      } else {
        btnBackWrapper?.classList.remove('hidden');
      }

      // Next / Submit button visibility
      if (currentStep === totalSteps) {
        btnNextWrapper?.classList.add('hidden');
        btnSubmitWrapper?.classList.remove('hidden');
      } else {
        btnNextWrapper?.classList.remove('hidden');
        btnSubmitWrapper?.classList.add('hidden');
      }

      // Hide general error when navigating steps
      errorEl?.classList.add('hidden');
      errorEl?.classList.remove('flex');
    }

    function validateCurrentStep(): boolean {
      const currentStepEl = document.getElementById(`step-${currentStep}`);
      if (!currentStepEl) return true;

      const inputs = currentStepEl.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea');
      let firstInvalid: HTMLElement | null = null;

      inputs.forEach((input) => {
        if (!input.checkValidity()) {
          if (!firstInvalid) firstInvalid = input;
          // Show native validation message on the first invalid field
        }
      });

      if (firstInvalid) {
        (firstInvalid as HTMLInputElement).reportValidity();
        return false;
      }
      return true;
    }

    btnNext?.addEventListener('click', () => {
      if (!validateCurrentStep()) return;
      if (currentStep < totalSteps) { currentStep++; updateWizard(); }
    });

    btnBack?.addEventListener('click', () => {
      if (currentStep > 1) { currentStep--; updateWizard(); }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous errors
      errorEl?.classList.add('hidden');
      errorEl?.classList.remove('flex');
      form.querySelectorAll('[data-error-for]').forEach(el => {
        el.textContent = '';
        el.classList.add('hidden');
      });

      btnSubmit.disabled = true;
      if (btnText) btnText.textContent = 'Enviando...';
      btnSpinner?.classList.remove('hidden');

      try {
        const formData = new FormData(form);
        const { error } = await actions.matricula(formData);

        if (error) {
          if (isInputError(error)) {
            // Map of field names to their step numbers
            const fieldStepMap: Record<string, number> = {
              curso: 1,
              nombres: 2, documento: 2, pais: 2, correo: 2, whatsapp: 2,
              formacion: 3, empresa: 3, cargo: 3, familiaridad_tecnologica: 3,
              tipo_comprobante: 4, razon_social: 4, numero_tributario: 4, nivel_ingles: 4, nivel_excel: 4,
            };

            let firstErrorStep = totalSteps;

            for (const [field, messages] of Object.entries(error.fields)) {
              const spanError = form.querySelector(`[data-error-for="${field}"]`);
              if (spanError && messages) {
                spanError.textContent = messages[0];
                spanError.classList.remove('hidden');
              }
              const step = fieldStepMap[field];
              if (step && step < firstErrorStep) firstErrorStep = step;
            }

            // Navigate to the step containing the first error
            if (firstErrorStep !== currentStep) {
              currentStep = firstErrorStep;
              updateWizard();
            }

            // Scroll to the first visible error
            const firstErrorSpan = form.querySelector('[data-error-for]:not(.hidden)');
            if (firstErrorSpan) {
              const fieldEl = firstErrorSpan.parentElement || firstErrorSpan;
              fieldEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return;
          }
          throw new Error(error.message || 'Ocurrió un error al enviar el formulario.');
        }

        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
        successEl?.classList.add('flex');
      } catch (err: any) {
        if (errorMsg) errorMsg.textContent = err.message || 'Error de conexión. Intente de nuevo.';
        errorEl?.classList.remove('hidden');
        errorEl?.classList.add('flex');
      } finally {
        btnSubmit.disabled = false;
        if (btnText) btnText.textContent = 'Finalizar Matrícula';
        btnSpinner?.classList.add('hidden');
      }
    });

    // Clear field errors on input (consistent with other forms)
    form.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
      if (target.name) {
        const errorSpan = form.querySelector(`[data-error-for="${target.name}"]`);
        if (errorSpan && !errorSpan.classList.contains('hidden')) {
          errorSpan.classList.add('hidden');
        }
      }
    });

    updateWizard();
  }

  document.addEventListener('astro:page-load', initMatricula);
  initMatricula();
</script>
