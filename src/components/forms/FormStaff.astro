---
import InputField from '../ui/InputField.astro';
import SelectField from '../ui/SelectField.astro';
import FileUploadField from '../ui/FileUploadField.astro';
import FormError from '../ui/FormError.astro';
import FormSubmitButton from '../ui/FormSubmitButton.astro';
import FormSuccess from '../ui/FormSuccess.astro';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div id="form-staff-wrapper" class:list={[className]}>
  <form
    id="form-staff"
    data-submission-form
    data-action="staff"
    data-submit-label="Enviar postulación"
    data-pending-label="Enviando..."
    data-error-id="form-staff-error"
    data-error-message-id="form-staff-error-msg"
    data-success-id="form-staff-success"
    method="POST"
    class="space-y-8"
    novalidate
  >
    <InputField label="Nombre completo" name="nombre_completo" placeholder="María Torres" required />
    <InputField label="Correo electrónico" name="correo_electronico" type="email" placeholder="maria.torres@correo.com" required />

    <SelectField
      label="Área de postulación"
      name="area_postulacion"
      required
      options={[
        { value: '', label: 'Seleccionar área' },
        'Docentes', 'Asesores de Venta', 'Growth', 'Product Management',
        'Marketing', 'Responsabilidad Social', 'Otro'
      ]}
    />

    <FileUploadField
      id="cv-file-input"
      name="cv_pdf"
      label="Adjuntar CV PDF"
      accept=".pdf,application/pdf"
      required
      size="compact"
      maxFileSizeMB={10}
      help="Archivo PDF. Máximo 10 MB."
    />

    <FormError id="form-staff-error" messageId="form-staff-error-msg" />

    <div class="pt-4">
      <FormSubmitButton id="form-staff-btn" label="Enviar postulación" />
    </div>
  </form>

  <FormSuccess id="form-staff-success" title="¡Postulación enviada!">
    <p>
      Nuestro equipo revisará tu CV y se pondrá en contacto pronto si tu perfil encaja con lo que buscamos.
    </p>
  </FormSuccess>
</div>

<script>
  import '../../scripts/submission-form';
</script>
