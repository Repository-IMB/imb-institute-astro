---
import InputField from '../ui/InputField.astro';
import PhoneInput from '../ui/PhoneInput.astro';
import FormError from '../ui/FormError.astro';
import FormSubmitButton from '../ui/FormSubmitButton.astro';
import FormSuccess from '../ui/FormSuccess.astro';

export interface Props {
  cursoNombre: string;
  class?: string;
}

const { cursoNombre, class: className } = Astro.props;
---

<div id="form-asesor-wrapper" class:list={[className]}>
  <form
    id="form-asesor"
    data-submission-form
    data-action="asesor"
    data-submit-label="Solicitar información"
    data-pending-label="Enviando..."
    data-error-id="form-asesor-error"
    data-error-message-id="form-asesor-error-msg"
    data-success-id="form-asesor-success"
    method="POST"
    class="space-y-8"
    novalidate
  >
    <input type="hidden" name="cursoNombre" value={cursoNombre} />
    <InputField label="Nombres y apellidos" name="nombres" placeholder="María Torres" required />
    <PhoneInput label="Teléfono o WhatsApp" name="telefono" id="asesor-telefono" required />
    <InputField label="Correo electrónico" name="correo" type="email" placeholder="maria.torres@correo.com" required />

    <FormError id="form-asesor-error" messageId="form-asesor-error-msg" />

    <div class="pt-4">
      <FormSubmitButton id="form-asesor-btn" label="Solicitar información" />
    </div>
  </form>

  <FormSuccess id="form-asesor-success" title="¡Solicitud recibida!">
    <p>
      Un asesor académico se comunicará contigo en breve con toda la información del programa.
    </p>
  </FormSuccess>
</div>

<script>
  import '../../scripts/submission-form';
</script>
