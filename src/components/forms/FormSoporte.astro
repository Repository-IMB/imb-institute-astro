---
import InputField from '../ui/InputField.astro';
import SelectField from '../ui/SelectField.astro';
import PhoneInput from '../ui/PhoneInput.astro';
import { ROUTES } from '../../config/routes';
import FormError from '../ui/FormError.astro';
import FormSubmitButton from '../ui/FormSubmitButton.astro';
import FormSuccess from '../ui/FormSuccess.astro';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div id="form-soporte-wrapper" class:list={[className]}>
  <form
    id="form-soporte"
    data-submission-form
    data-action="soporte"
    data-submit-label="Enviar consulta"
    data-pending-label="Enviando..."
    data-error-id="form-soporte-error"
    data-error-message-id="form-soporte-error-msg"
    data-success-id="form-soporte-success"
    method="POST"
    class="space-y-8"
    novalidate
  >
    <InputField label="Nombres y apellidos" name="nombres" placeholder="María Torres" required />

    <InputField label="Correo electrónico" name="correo" type="email" placeholder="maria.torres@correo.com" required />
    <PhoneInput label="Teléfono o WhatsApp" name="telefono" id="soporte-telefono" required />

    <InputField label="Curso matriculado" name="curso" placeholder="Escribe el nombre que figura en tu matrícula" required />

    <SelectField
      label="Categoría de ayuda"
      name="categoria"
      required
      options={[
        { value: '', label: 'Selecciona el motivo de tu consulta' },
        'Problemas con el Aula Virtual (no carga, no se ve)',
        'Consulta sobre Certificados',
        'Soporte Técnico (plataforma, acceso)',
        'Problemas con Links de clase',
        'Problemas con Grabaciones',
        'Otros'
      ]}
    />

    <input type="hidden" name="estado" value="Pendiente" />

    <InputField label="Mensaje" name="mensaje" type="textarea" rows={4} placeholder="Describe el problema y cuándo comenzó" required />

    <div class="flex items-start gap-3">
      <input
        id="soporte-privacidad"
        type="checkbox"
        name="terminos"
        required
        class="mt-1 size-4 shrink-0 cursor-pointer rounded border-border-subtle bg-surface-50 text-imb focus:ring-2 focus:ring-imb/20 focus:ring-offset-2"
      />
      <label for="soporte-privacidad" class="cursor-pointer font-sans text-sm leading-relaxed text-text-secondary">
        Acepto la <a href={ROUTES.POLITICA_PRIVACIDAD} class="font-semibold text-imb underline decoration-imb/40 underline-offset-3 transition-colors hover:text-imb-hover focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-imb">Política de Privacidad</a> y el tratamiento de mis datos para recibir asistencia académica.
      </label>
    </div>

    <FormError id="form-soporte-error" messageId="form-soporte-error-msg" />

    <div class="pt-4">
      <FormSubmitButton id="form-soporte-btn" label="Enviar consulta" />
    </div>
  </form>

  <FormSuccess id="form-soporte-success" title="¡Consulta enviada!">
    <p>
      Nuestro equipo de soporte atenderá tu caso y te contactará en el menor tiempo posible.
    </p>
  </FormSuccess>
</div>

<script>
  import '../../scripts/submission-form';
</script>
