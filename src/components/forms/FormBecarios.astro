---
import InputField from '../ui/InputField.astro';
import SelectField from '../ui/SelectField.astro';
import PhoneInput from '../ui/PhoneInput.astro';
import FormError from '../ui/FormError.astro';
import FormSubmitButton from '../ui/FormSubmitButton.astro';
import FormSuccess from '../ui/FormSuccess.astro';
import { Upload } from 'lucide-astro';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div id="form-becarios-wrapper" class:list={[className]}>
  <FormSuccess id="form-becarios-success" title="Postulación enviada" class="px-6">
    <p>
      Registramos tu postulación al Programa de Becarios IMB. El equipo académico revisará tu perfil y los documentos adjuntos.
    </p>
  </FormSuccess>

  <form id="form-becarios" method="POST" class="space-y-8" novalidate>
    <div class="space-y-6">
      <h3 class="border-b border-border-subtle pb-3 text-item-title">1. Datos personales</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <InputField label="Nombre" name="nombres" placeholder="María" required />
        <InputField label="Apellidos" name="apellidos" placeholder="Torres Silva" required />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <InputField label="DNI / Pasaporte" name="documento" placeholder="Escribe tu número de documento" required />
        <InputField label="Fecha de nacimiento" name="fecha_nacimiento" type="date" required />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <InputField label="Correo electrónico" name="correo" type="email" placeholder="maria.torres@correo.com" required />
        <PhoneInput label="Número de teléfono o WhatsApp" name="whatsapp" id="becarios-whatsapp" required />
      </div>
    </div>

    <div class="space-y-6 pt-6">
      <h3 class="border-b border-border-subtle pb-3 text-item-title">2. Perfil académico</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <InputField label="Universidad o institución" name="universidad" placeholder="" required />
        <InputField label="Carrera universitaria" name="carrera" placeholder="" required />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <SelectField
          label="Ciclo actual o semestre"
          name="ciclo"
          required
          options={[
            { value: '', label: 'Selecciona tu ciclo actual' },
            '1er Ciclo', '2do Ciclo', '3er Ciclo', '4to Ciclo',
            '5to Ciclo', '6to Ciclo', '7mo Ciclo', '8vo Ciclo',
            '9no Ciclo', '10mo Ciclo', '11vo Ciclo', '12vo Ciclo'
          ]}
        />
        <InputField label="Capítulo o asociación estudiantil" name="asociacion" placeholder="" required />
      </div>
    </div>

    <div class="space-y-6 pt-6">
      <h3 class="border-b border-border-subtle pb-3 text-item-title">3. Disponibilidad horaria</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-3">
          <label class="block font-sans text-sm font-medium text-text-secondary">Lunes a Viernes <span class="text-imb">*</span></label>
          <div class="flex flex-wrap gap-4 pt-1">
            {['Mañana', 'Tarde', 'Noche'].map((time) => (
              <label class="flex items-center gap-2 cursor-pointer font-sans text-sm text-text-primary">
                <input type="checkbox" name="horario_semana" value={time} class="size-4 cursor-pointer rounded border-border-subtle bg-surface-50 text-imb focus:ring-2 focus:ring-imb/20 focus:ring-offset-2" />
                {time}
              </label>
            ))}
          </div>
        </div>
        <div class="space-y-3">
          <label class="block font-sans text-sm font-medium text-text-secondary">Sábados y Domingos <span class="text-imb">*</span></label>
          <div class="flex flex-wrap gap-4 pt-1">
            {['Mañana', 'Tarde', 'Noche'].map((time) => (
              <label class="flex items-center gap-2 cursor-pointer font-sans text-sm text-text-primary">
                <input type="checkbox" name="horario_finde" value={time} class="size-4 cursor-pointer rounded border-border-subtle bg-surface-50 text-imb focus:ring-2 focus:ring-imb/20 focus:ring-offset-2" />
                {time}
              </label>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-6 pt-6">
      <h3 class="border-b border-border-subtle pb-3 text-item-title">4. Declaración de interés</h3>
      <InputField label="Motivación" name="motivacion" type="textarea" rows={4} placeholder="Cuéntanos por qué quieres participar en el programa" required />
    </div>

    <div class="space-y-6 pt-6">
      <h3 class="border-b border-border-subtle pb-3 text-item-title">5. Documentos de respaldo</h3>
      <div class="space-y-2">
        <label class="block font-sans text-sm font-medium text-text-secondary">Documentos <span class="text-imb">*</span></label>
        <div id="file-drop-zone" class="group flex cursor-pointer flex-col items-center rounded-xl border-2 border-dashed border-border-subtle p-8 text-center transition-colors duration-200 hover:border-imb hover:bg-surface-50">
          <div class="w-12 h-12 rounded-xl bg-surface-50 flex items-center justify-center text-icon-muted mb-3 group-hover:text-imb transition-colors border border-border-subtle">
            <Upload size={24} aria-hidden="true" />
          </div>
          <p class="mb-1 text-meta font-semibold text-text-primary">Haz clic o arrastra archivos a esta área</p>
          <p class="mb-3 text-caption text-text-secondary">Hasta 5 archivos. Máximo 5 MB en total.</p>
          <p class="max-w-md text-caption text-text-secondary">Bases, constancia de tercio o quinto superior, certificados o CV documentado.</p>
          <input type="file" id="documentos-input" name="documentos" multiple class="hidden" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
        </div>
        <div id="file-list" class="space-y-2 mt-4"></div>
      </div>
    </div>

    <FormError id="form-becarios-error" messageId="form-becarios-error-msg" />

    <div class="pt-6">
      <FormSubmitButton id="form-becarios-btn" label="Enviar postulación" />
    </div>
  </form>
</div>

<script>
  import { actions, isInputError } from 'astro:actions';

  function initBecarios() {
    const form = document.getElementById('form-becarios') as HTMLFormElement;
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    const dropZone = document.getElementById('file-drop-zone');
    const fileInput = document.getElementById('documentos-input') as HTMLInputElement;
    const fileList = document.getElementById('file-list');
    let selectedFiles: File[] = [];

    dropZone?.addEventListener('click', () => fileInput?.click());
    dropZone?.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-imb', 'bg-surface-50'); });
    dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('border-imb', 'bg-surface-50'));
    dropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-imb', 'bg-surface-50');
      if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
    });
    fileInput?.addEventListener('change', () => { if (fileInput.files) addFiles(fileInput.files); });

    function addFiles(files: FileList) {
      for (let i = 0; i < files.length; i++) {
        if (selectedFiles.length >= 5) { alert('Solo puedes subir un máximo de 5 archivos.'); break; }
        const file = files[i];
        if (!selectedFiles.some((f) => f.name === file.name)) selectedFiles.push(file);
      }
      updateFileList();
      syncFileInput();
    }

    function removeFile(index: number) { selectedFiles.splice(index, 1); updateFileList(); syncFileInput(); }

    function syncFileInput() {
      const dt = new DataTransfer();
      selectedFiles.forEach((f) => dt.items.add(f));
      if (fileInput) fileInput.files = dt.files;
    }

    function formatBytes(bytes: number) {
      if (bytes === 0) return '0 Bytes';
      const sizes = ['Bytes', 'KB', 'MB'];
      const i = Math.floor(Math.log(bytes) / Math.log(1024));
      return parseFloat((bytes / Math.pow(1024, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function updateFileList() {
      if (!fileList) return;
      fileList.innerHTML = '';
      selectedFiles.forEach((file, index) => {
        const item = document.createElement('div');
        item.className = 'flex items-center justify-between p-3 bg-surface-0 border border-border-subtle rounded-xl text-sm';
        item.innerHTML = `
          <div class="flex items-center gap-3 truncate">
            <svg class="w-5 h-5 text-icon-muted shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
            <div class="truncate">
              <p class="font-medium text-text-primary truncate">${file.name}</p>
              <p class="text-caption text-text-secondary">${formatBytes(file.size)}</p>
            </div>
          </div>
          <button type="button" class="text-xs font-bold text-imb hover:underline ml-2 shrink-0 cursor-pointer remove-file-btn" data-index="${index}">Eliminar</button>`;
        fileList.appendChild(item);
      });
      fileList.querySelectorAll('.remove-file-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          removeFile(parseInt((e.target as HTMLElement).dataset.index || '0'));
        });
      });
    }

    const errorEl = document.getElementById('form-becarios-error');
    const errorMsg = document.getElementById('form-becarios-error-msg');
    const successEl = document.getElementById('form-becarios-success');
    const btn = document.getElementById('form-becarios-btn') as HTMLButtonElement;
    const btnText = btn?.querySelector('.btn-text');
    const btnSpinner = btn?.querySelector('.btn-spinner');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();


      const horarioSemana = form.querySelectorAll('input[name="horario_semana"]:checked');
      const horarioFinde = form.querySelectorAll('input[name="horario_finde"]:checked');
      if (horarioSemana.length === 0 || horarioFinde.length === 0) {
        if (errorMsg) errorMsg.textContent = 'Debes seleccionar al menos una opción de disponibilidad para Lunes a Viernes y para Sábados y Domingos.';
        errorEl?.classList.remove('hidden');
        errorEl?.classList.add('flex');
        return;
      }
      if (selectedFiles.length === 0) {
        if (errorMsg) errorMsg.textContent = 'Debes subir al menos un documento (bases, constancia o CV).';
        errorEl?.classList.remove('hidden');
        errorEl?.classList.add('flex');
        return;
      }

      errorEl?.classList.add('hidden');
      errorEl?.classList.remove('flex');
      btn.disabled = true;
      if (btnText) btnText.textContent = 'Enviando...';
      btnSpinner?.classList.remove('hidden');

      try {
        const formData = new FormData(form);
        
        // Validación de tamaño máximo de archivo (5 MB en total)
        let totalSize = 0;
        selectedFiles.forEach(f => totalSize += f.size);
        if (totalSize > 5 * 1024 * 1024) {
          throw new Error('El peso total de los archivos supera 5 MB. Reduce su tamaño antes de enviarlos.');
        }

        const { error } = await actions.becarios(formData);

        if (error) {
          if (isInputError(error)) {
            form.querySelectorAll('[data-error-for]').forEach(el => el.classList.add('hidden'));
            for (const [field, messages] of Object.entries(error.fields)) {
              const spanError = form.querySelector(`[data-error-for="${field}"]`);
              if (spanError && messages) {
                spanError.textContent = messages[0];
                spanError.classList.remove('hidden');
              }
            }
            
            // Hacer scroll hacia el primer error visible
            const firstErrorSpan = form.querySelector('[data-error-for]:not(.hidden)');
            if (firstErrorSpan) {
              const fieldEl = firstErrorSpan.parentElement || firstErrorSpan;
              fieldEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return;
          }
          throw new Error(error.message || 'Ocurrió un error al enviar el formulario.');
        }

        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
        successEl?.classList.add('flex');
        
      } catch (err: any) {
        if (errorMsg) errorMsg.textContent = err.message || 'Error de conexión. Intente de nuevo.';
        errorEl?.classList.remove('hidden');
        errorEl?.classList.add('flex');
      } finally {
        btn.disabled = false;
        if (btnText) btnText.textContent = 'Enviar postulación';
        btnSpinner?.classList.add('hidden');
      }
    });

    // Ocultar el error de un campo cuando el usuario vuelve a editarlo.
    form.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
      if (target.name) {
        const errorSpan = form.querySelector(`[data-error-for="${target.name}"]`);
        if (errorSpan && !errorSpan.classList.contains('hidden')) {
          errorSpan.classList.add('hidden');
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initBecarios);
  initBecarios();
</script>
