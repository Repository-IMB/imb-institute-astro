---
import InputField from '../ui/InputField.astro';
import SelectField from '../ui/SelectField.astro';
import PhoneInput from '../ui/PhoneInput.astro';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div id="form-alianzas-wrapper" class:list={[className]}>
  <form id="form-alianzas" method="POST" class="space-y-8" novalidate>
    <InputField label="Nombre de la Empresa" name="empresa" placeholder="Razón social corporativa" />

    <SelectField
      label="¿Qué tipo de alianza busca?"
      name="tipoAlianza"
      required={false}
      options={[
        'Convenios Institucionales',
        'Capacitación IN house',
        'Patrocinios y alianzas',
        'Bolsa de trabajo',
        'Networking y Ruedas de Negocios',
        'Otros'
      ]}
    />

    <SelectField
      label="¿En qué sector se encuentra?"
      name="sector"
      required={false}
      options={[
        'MINERÍA', 'CONSTRUCCIÓN', 'SALUD', 'TECNOLOGÍA', 'FINANZAS',
        'RECURSOS HUMANOS', 'LOGÍSTICA Y PRODUCCIÓN', 'TECNOLOGÍAS DE LA INFORMACIÓN', 'DERECHO Y LEYES'
      ]}
    />

    <InputField label="Correo electrónico" name="correo" type="email" placeholder="correo@empresa.com" />
    <PhoneInput label="Teléfono" name="telefono" id="alianzas-telefono" required={false} />
    <InputField label="Cuéntanos más sobre tu proyecto" name="descripcion" type="textarea" rows={4} required={false} placeholder="Cuéntanos sobre tu proyecto o propuesta de alianza..." />

    <div id="form-alianzas-error" class="hidden items-start gap-3 p-4 bg-rose-50 border border-rose-100 rounded-xl text-rose-800 text-sm leading-relaxed">
      <svg class="w-5 h-5 shrink-0 mt-0.5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span id="form-alianzas-error-msg"></span>
    </div>

    <div class="pt-2">
      <button
        id="form-alianzas-btn"
        type="submit"
        class="w-full py-4 inline-flex items-center justify-center gap-2 px-6 rounded-md font-display font-semibold transition-all duration-200 ease-out text-sm tracking-wide cursor-pointer bg-imb text-white hover:bg-imb-hover shadow-sm disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span class="btn-text">Enviar</span>
        <svg class="btn-spinner hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
      </button>
    </div>
  </form>

  <div id="form-alianzas-success" class="hidden flex-col items-center text-center py-8 gap-4">
    <div class="w-16 h-16 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center mb-2">
      <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h3 class="font-display text-xl font-bold text-text-primary">¡Propuesta recibida!</h3>
    <p class="font-sans text-text-secondary leading-relaxed max-w-sm">
      Gracias por tu interés en aliarte con IMB Institute. Nuestro equipo revisará tu propuesta y se pondrá en contacto pronto.
    </p>
  </div>
</div>

<script>
  import { actions, isInputError } from 'astro:actions';

  function initAlianzas() {
    const form = document.getElementById('form-alianzas') as HTMLFormElement;
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    const errorEl = document.getElementById('form-alianzas-error');
    const errorMsg = document.getElementById('form-alianzas-error-msg');
    const successEl = document.getElementById('form-alianzas-success');
    const btn = document.getElementById('form-alianzas-btn') as HTMLButtonElement;
    const btnText = btn?.querySelector('.btn-text');
    const btnSpinner = btn?.querySelector('.btn-spinner');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();


      errorEl?.classList.add('hidden');
      errorEl?.classList.remove('flex');
      btn.disabled = true;
      if (btnText) btnText.textContent = 'Enviando...';
      btnSpinner?.classList.remove('hidden');

      try {
        const formData = new FormData(form);
        const { error } = await actions.alianzas(formData);

        if (error) {
          if (isInputError(error)) {
            form.querySelectorAll('[data-error-for]').forEach(el => el.classList.add('hidden'));
            for (const [field, messages] of Object.entries(error.fields)) {
              const spanError = form.querySelector(`[data-error-for="${field}"]`);
              if (spanError && messages) {
                spanError.textContent = messages[0];
                spanError.classList.remove('hidden');
              }
            }
            return;
          }
          throw new Error(error.message || 'Ocurrió un error al enviar el formulario.');
        }

        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
        successEl?.classList.add('flex');
        
      } catch (err: any) {
        if (errorMsg) errorMsg.textContent = err.message || 'Error de conexión. Intente de nuevo.';
        errorEl?.classList.remove('hidden');
        errorEl?.classList.add('flex');
      } finally {
        btn.disabled = false;
        if (btnText) btnText.textContent = 'Enviar';
        btnSpinner?.classList.add('hidden');
      }
    });

    // Ocultar error cuando el usuario modifica un campo
    form.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
      if (target.name) {
        const errorSpan = form.querySelector(`[data-error-for="${target.name}"]`);
        if (errorSpan && !errorSpan.classList.contains('hidden')) {
          errorSpan.classList.add('hidden');
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initAlianzas);
  initAlianzas();
</script>
