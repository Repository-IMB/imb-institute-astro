---
import InputField from '../ui/InputField.astro';
import SelectField from '../ui/SelectField.astro';
import PhoneInput from '../ui/PhoneInput.astro';
import FormError from '../ui/FormError.astro';
import FormSubmitButton from '../ui/FormSubmitButton.astro';
import FormSuccess from '../ui/FormSuccess.astro';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div id="form-alianzas-wrapper" class:list={[className]}>
  <form
    id="form-alianzas"
    data-submission-form
    data-action="alianzas"
    data-submit-label="Enviar propuesta"
    data-pending-label="Enviando..."
    data-error-id="form-alianzas-error"
    data-error-message-id="form-alianzas-error-msg"
    data-success-id="form-alianzas-success"
    method="POST"
    class="space-y-8"
    novalidate
  >
    <InputField label="Nombre de la empresa" name="empresa" placeholder="Escribe el nombre legal de la organización" required />

    <SelectField
      label="¿Qué tipo de alianza buscas?"
      name="tipoAlianza"
      required
      options={[
        'Convenios institucionales',
        'Capacitación in-house',
        'Patrocinios y alianzas',
        'Bolsa de trabajo',
        'Networking y ruedas de negocios',
        'Otros'
      ]}
    />

    <SelectField
      label="¿En qué sector trabaja tu organización?"
      name="sector"
      required
      options={[
        'Minería', 'Construcción', 'Salud', 'Tecnología', 'Finanzas',
        'Recursos Humanos', 'Logística y producción', 'Tecnologías de la información', 'Derecho y leyes'
      ]}
    />

    <InputField label="Correo electrónico" name="correo" type="email" placeholder="contacto@empresa.com" required />
    <PhoneInput label="Teléfono" name="telefono" id="alianzas-telefono" required />
    <InputField label="Cuéntanos más sobre tu proyecto" name="descripcion" type="textarea" rows={4} required placeholder="Describe brevemente el proyecto o la propuesta" />

    <FormError id="form-alianzas-error" messageId="form-alianzas-error-msg" />

    <div class="pt-4">
      <FormSubmitButton id="form-alianzas-btn" label="Enviar propuesta" />
    </div>
  </form>

  <FormSuccess id="form-alianzas-success" title="Propuesta recibida">
    <p>
      Nuestro equipo de Relaciones Institucionales revisará la información y se comunicará contigo mediante los datos proporcionados.
    </p>
  </FormSuccess>
</div>

<script>
  import '../../scripts/submission-form';
</script>
