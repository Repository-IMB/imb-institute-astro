---
import InputField from '../ui/InputField.astro';
import SelectField from '../ui/SelectField.astro';
import Button from '../ui/Button.astro';
import PhoneInput from '../ui/PhoneInput.astro';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<form
  method="POST"
  action="/actions/alianzas"
  class:list={["space-y-8", className]}
>
  <InputField label="Nombre de la Empresa" name="empresa" required={true} placeholder="Razón social corporativa" />

  <SelectField
    label="¿Qué tipo de alianza busca?"
    name="tipoAlianza"
    required={false}
    options={[
      'Convenios Institucionales',
      'Capacitación IN house',
      'Patrocinios y alianzas',
      'Bolsa de trabajo',
      'Networking y Ruedas de Negocios',
      'Otros'
    ]}
  />

  <SelectField
    label="¿En qué sector se encuentra?"
    name="sector"
    required={false}
    options={[
      'MINERÍA',
      'CONSTRUCCIÓN',
      'SALUD',
      'TECNOLOGÍA',
      'FINANZAS',
      'RECURSOS HUMANOS',
      'LOGÍSTICA Y PRODUCCIÓN',
      'TECNOLOGÍAS DE LA INFORMACIÓN',
      'DERECHO Y LEYES'
    ]}
  />

  <InputField label="Correo electrónico" name="correo" type="email" required={true} placeholder="correo@empresa.com" />
  <PhoneInput label="Teléfono" name="telefono" id="alianzas-telefono" required={false} />
  <InputField label="Cuéntanos más sobre tu proyecto" name="descripcion" type="textarea" rows={4} required={false} placeholder="Cuéntanos sobre tu proyecto o propuesta de alianza..." />

  <div class="pt-2">
    <Button
      type="submit"
      class="w-full py-4"
    >
      Enviar
    </Button>
  </div>
</form>
