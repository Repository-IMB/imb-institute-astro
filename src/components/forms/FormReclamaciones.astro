---
import InputField from '../ui/InputField.astro';
import SelectField from '../ui/SelectField.astro';
import PhoneInput from '../ui/PhoneInput.astro';
import FileUploadField from '../ui/FileUploadField.astro';
import FormError from '../ui/FormError.astro';
import FormSubmitButton from '../ui/FormSubmitButton.astro';
import FormSuccess from '../ui/FormSuccess.astro';
import AddressFields from './fields/AddressFields.astro';
import { ROUTES } from '../../config/routes';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div id="form-reclamaciones-wrapper" class:list={[className]}>
  <form
    id="form-reclamaciones"
    data-submission-form
    data-action="reclamaciones"
    data-submit-label="Registrar reclamación"
    data-pending-label="Enviando..."
    data-error-id="form-reclamaciones-error"
    data-error-message-id="form-reclamaciones-error-msg"
    data-success-id="form-reclamaciones-success"
    method="POST"
    class="space-y-12"
    novalidate
  >
    <div class="space-y-8">
      <h3 class="border-b border-border-subtle pb-4 text-card-title">1. Datos del consumidor</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <InputField label="Fecha" name="fecha" type="date" required />
        <InputField label="Nombre completo" name="nombres" placeholder="María Torres" required />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <InputField label="Documento de identidad (DNI, CE o pasaporte)" name="documento" placeholder="Número de documento" required />
        <PhoneInput label="Teléfono o celular" name="telefono" id="reclamaciones-telefono" required />
      </div>
      <InputField label="Correo electrónico" name="correo" type="email" placeholder="maria.torres@correo.com" required />
      <AddressFields required />
      <InputField label="Nombre del apoderado (solo si es menor de edad)" name="apoderado" required={false} placeholder="Carlos Torres" />
    </div>

    <div class="space-y-8">
      <h3 class="border-b border-border-subtle pb-4 text-card-title">2. Detalle del bien contratado</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <SelectField
          label="Indique el tipo de bien"
          name="tipoBien"
          required
          options={[
            { value: '', label: 'Seleccione el tipo de bien' },
            'Producto',
            'Servicio'
          ]}
        />
        <InputField label="Número de comprobante (boleta o factura)" name="comprobante" required={false} />
      </div>
      <InputField label="Producto o servicio adquirido" name="detalleBien" required />
      <InputField label="Monto reclamado" name="montoReclamado" type="number" required />
      <InputField
        label="Descripción del producto o servicio reclamado"
        name="descripcionBien"
        type="textarea"
        rows={4}
        required
        placeholder="Describa el producto o servicio relacionado con su solicitud"
      />
    </div>

    <div class="space-y-8">
      <h3 class="border-b border-border-subtle pb-4 text-card-title">3. Detalle del reclamo o queja</h3>
      <SelectField
        label="Tipo de solicitud"
        name="tipoSolicitud"
        required
        options={[
          { value: '', label: 'Seleccione el motivo de su reporte' },
          'Reclamo',
          'Queja'
        ]}
      />
      <InputField label="Detalle" name="detalleReclamo" type="textarea" rows={4} placeholder="Describa los hechos y las fechas relevantes" required />
      <InputField label="Pedido" name="pedido" type="textarea" rows={4} placeholder="Indique qué solución solicita" required />
      <FileUploadField
        id="reclamaciones-archivo"
        name="archivo"
        label="Documento de respaldo"
        accept=".pdf,.jpg,.jpeg,.png"
        maxFileSizeMB={5}
        help="PDF, JPG o PNG. Máximo 5 MB."
      />
      <div>
        <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-border-subtle px-4 py-3 font-sans text-sm leading-relaxed text-text-secondary transition-colors hover:border-imb/50 focus-within:border-imb focus-within:ring-2 focus-within:ring-imb/15">
          <input
            type="checkbox"
            name="privacidad"
            required
            class="mt-1 size-4 shrink-0 cursor-pointer rounded border-border-subtle bg-surface-50 text-imb focus:ring-2 focus:ring-imb/20 focus:ring-offset-2"
          />
          <span>
            Autorizo el tratamiento de mis datos personales para atender esta solicitud, de acuerdo con la
            <a href={ROUTES.POLITICA_PRIVACIDAD} target="_blank" rel="noopener noreferrer" class="font-semibold text-imb underline decoration-imb/40 underline-offset-3 transition-colors hover:text-imb-hover focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-imb"> Política de Privacidad</a>.
            <span class="text-imb">*</span>
          </span>
        </label>
        <span class="mt-1 hidden text-xs font-medium text-feedback-error" data-error-for="privacidad"></span>
      </div>
    </div>

    <FormError id="form-reclamaciones-error" messageId="form-reclamaciones-error-msg" />

    <div class="pt-6">
      <FormSubmitButton id="form-reclamaciones-btn" label="Registrar reclamación" />
    </div>
  </form>

  <FormSuccess id="form-reclamaciones-success" title="Reclamación registrada">
    <p>
      Su solicitud quedó registrada en el Libro de Reclamaciones. Enviaremos una constancia al correo electrónico indicado.
    </p>
  </FormSuccess>
</div>

<script>
  import '../../scripts/submission-form';
</script>
