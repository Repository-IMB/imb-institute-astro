---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wrapper from '../components/ui/Wrapper.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import FormBecarios from '../components/forms/FormBecarios.astro';
import programaBecariosHero from '../assets/images/programa-becarios-hero.webp';
import { Users2, Award, FileText, Download, CheckCircle2 } from 'lucide-astro';

export const prerender = true;

const beneficios = [
  'Acceso becado a programas académicos especializados de IMB.',
  'Experiencia formativa en entornos de educación virtual.',
  'Interacción académica con docentes y profesionales del sector.',
  'Emisión de una carta de recomendación por la participación en el programa.'
];
---

<BaseLayout
  title="Programa de becarios | IMB Institute"
  description="Consulta los requisitos y presenta tu postulación al Programa de Becarios de IMB Institute."
  image={programaBecariosHero}
>
  <HeroSection
    title="Programa de becarios"
    highlight="becarios"
    description="Una oportunidad para estudiantes de últimos ciclos que quieren complementar su formación y participar en actividades académicas virtuales."
    image={programaBecariosHero}
  />

  <Wrapper class="bg-surface-50 py-20 lg:py-28" padded={false}>
    <div class="grid items-start gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="space-y-10 lg:col-span-5">
        <section class="border-t border-border-subtle pt-7">
          <div class="mb-4 flex items-center gap-4">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-surface-0 text-imb" aria-hidden="true">
              <Users2 size={20} />
            </div>
            <h2 class="text-card-title">A quién está dirigido</h2>
          </div>
          <p class="leading-relaxed text-text-secondary">
            El programa está dirigido a estudiantes universitarios de los últimos ciclos de carreras afines, con buen rendimiento académico, responsabilidad y disponibilidad para participar en actividades académicas virtuales.
          </p>
        </section>

        <section class="border-t border-border-subtle pt-7">
          <div class="mb-5 flex items-center gap-4">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-surface-0 text-imb" aria-hidden="true">
              <Award size={20} />
            </div>
            <h2 class="text-card-title">Qué incluye el programa</h2>
          </div>
          <ul class="space-y-3 text-text-secondary">
            {beneficios.map((beneficio) => (
              <li class="flex items-start gap-3">
                <CheckCircle2 size={17} class="mt-1 shrink-0 text-imb" aria-hidden="true" />
                <span class="leading-relaxed">{beneficio}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="border-t border-border-subtle pt-7">
          <div class="mb-4 flex items-center gap-4">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-surface-0 text-imb" aria-hidden="true">
              <FileText size={20} />
            </div>
            <h2 class="text-card-title">Bases del programa</h2>
          </div>
          <p class="leading-relaxed text-text-secondary">
            Revisa los requisitos, derechos, deberes y etapas de postulación antes de completar el formulario.
          </p>
          <Button
            href="https://recursos.imbinstitute.com/2026/01/BASES-CONVENIO-PROGRAMA-DE-BECARIOS-IMB-2026.pdf"
            target="_blank"
            rel="noopener noreferrer"
            variant="outline"
            class="mt-6 min-h-12 gap-2 px-6"
          >
            <Download size={18} aria-hidden="true" />
            Descargar las bases
          </Button>
        </section>
      </div>

      <Card class="rounded-xl! p-8 shadow-none! hover:shadow-none! lg:col-span-7 lg:p-12">
        <div class="mb-8 border-b border-border-subtle pb-7">
          <h2 class="text-component-title">Presenta tu postulación</h2>
          <p class="mt-3 text-meta text-text-secondary">
            Completa los campos y adjunta la documentación solicitada en PDF o imagen.
          </p>
        </div>
        <FormBecarios />
      </Card>
    </div>
  </Wrapper>
</BaseLayout>
