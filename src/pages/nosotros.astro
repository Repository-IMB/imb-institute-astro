---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Wrapper from '../components/ui/Wrapper.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import FormContacto from '../components/forms/FormContacto.astro';
import nosotrosHero from '../assets/images/nosotros-hero.webp';
import { Award, RefreshCw, HeartHandshake, Users2, Target, Compass, CheckCircle2 } from 'lucide-astro';

export const prerender = true;

const valores = [
  { icon: Award, title: 'Excelencia', desc: 'Cuidamos la calidad de los contenidos, la enseñanza y cada punto de contacto con nuestros alumnos.' },
  { icon: RefreshCw, title: 'Adaptabilidad', desc: 'Revisamos nuestros programas para responder a nuevas herramientas y formas de trabajo.' },
  { icon: HeartHandshake, title: 'Compromiso', desc: 'Acompañamos el proceso de aprendizaje y asumimos con seriedad cada responsabilidad.' },
  { icon: Users2, title: 'Empatía', desc: 'Escuchamos las necesidades de profesionales y organizaciones antes de proponer una solución.' }
];
---

<BaseLayout
  title="Nosotros | IMB Institute"
  description="Conoce el enfoque, la misión y los valores que orientan la formación profesional de IMB Institute."
  image={nosotrosHero}
>
  <HeroSection
    title="Formación conectada con el trabajo real"
    highlight="trabajo real"
    description="Diseñamos cursos para profesionales y organizaciones que necesitan aprender, actualizarse y aplicar lo aprendido."
    image={nosotrosHero}
  />

  <Wrapper class="bg-surface-0 py-24 lg:py-32" padded={false}>
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <p class="mb-4 text-label uppercase tracking-widest text-imb">Quiénes somos</p>
        <h2 class="text-section-title">
          Cursos pensados para profesionales que siguen aprendiendo
        </h2>
      </div>
      <div class="lg:col-span-7">
        <p class="text-lead text-text-secondary">
          IMB Institute desarrolla programas de capacitación para personas y equipos de trabajo. Combinamos contenidos técnicos, herramientas digitales y acompañamiento docente para facilitar un aprendizaje que pueda trasladarse al día a día profesional.
        </p>
      </div>
    </div>

    <div class="mt-16 grid gap-6 border-t border-border-subtle pt-12 md:grid-cols-2">
      <Card class="rounded-xl! p-8 shadow-none! hover:shadow-none! lg:p-10">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-surface-50 text-imb" aria-hidden="true">
          <Target size={22} />
        </div>
        <h3 class="text-card-title">Nuestra misión</h3>
        <p class="mt-4 leading-relaxed text-text-secondary">
          Brindar formación útil para profesionales y organizaciones, conectando el conocimiento con los retos de los sectores donde trabajan.
        </p>
      </Card>

      <Card class="rounded-xl! p-8 shadow-none! hover:shadow-none! lg:p-10">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-surface-50 text-imb" aria-hidden="true">
          <Compass size={22} />
        </div>
        <h3 class="text-card-title">Nuestra visión</h3>
        <p class="mt-4 leading-relaxed text-text-secondary">
          Ser una institución reconocida en América Latina por la calidad de su capacitación especializada y su cercanía con el entorno profesional.
        </p>
      </Card>
    </div>
  </Wrapper>

  <Wrapper class="bg-surface-50 py-24 lg:py-32" padded={false}>
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <p class="mb-4 text-label uppercase tracking-widest text-imb">Cómo trabajamos</p>
        <h2 class="text-section-title">Nuestros valores</h2>
        <p class="mt-6 max-w-md leading-relaxed text-text-secondary">
          Son criterios sencillos, pero importantes. Orientan cómo diseñamos los cursos y cómo acompañamos a cada alumno.
        </p>
      </div>

      <div class="grid gap-x-12 md:grid-cols-2 lg:col-span-8">
        {valores.map((valor) => (
          <article class="grid grid-cols-[48px_1fr] gap-5 border-t border-border-subtle py-8">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-surface-0 text-imb" aria-hidden="true">
              <valor.icon size={21} />
            </div>
            <div>
              <h3 class="text-item-title">{valor.title}</h3>
              <p class="mt-3 leading-relaxed text-text-secondary">{valor.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </Wrapper>

  <Wrapper class="bg-surface-0 py-24 lg:py-32" padded={false}>
    <div class="grid items-start gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <p class="mb-4 text-label uppercase tracking-widest text-imb">Conversemos</p>
        <h2 class="text-section-title">
          ¿Quieres conocer nuestros programas?
        </h2>
        <p class="mt-6 max-w-xl leading-relaxed text-text-secondary">
          Déjanos tus datos y cuéntanos qué área te interesa. Un asesor académico revisará tu consulta.
        </p>
      </div>

      <Card class="rounded-xl! p-8 shadow-none! hover:shadow-none! lg:col-span-7 lg:p-12">
        <div class="mb-10 flex items-center gap-3 border-b border-border-subtle pb-8">
          <h3 class="text-component-title">Cuéntanos qué necesitas</h3>
        </div>
        <FormContacto />
      </Card>
    </div>
  </Wrapper>
</BaseLayout>
