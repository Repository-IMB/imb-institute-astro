---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Wrapper from '../components/ui/Wrapper.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import FormAlianzas from '../components/forms/FormAlianzas.astro';

export const prerender = true;
---

<BaseLayout
  title="Contáctanos | IMB Institute"
  description="Comparte una propuesta de alianza institucional con IMB Institute para que nuestro equipo pueda evaluarla."
>
  <HeroSection
    title="Transformamos Conocimiento en Crecimiento"
    description="En IMB Institute, creemos en el aprendizaje como el motor que impulsa a profesionales y organizaciones hacia la excelencia. Descubre cómo nuestra pasión por la innovación y la calidad puede potenciar tu futuro."
    image="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&q=85&w=2000"
  />

  <Wrapper class="bg-surface-50 py-20 lg:py-28" padded={false}>
    <div class="grid items-start gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <p class="mb-4 text-label uppercase tracking-widest text-imb">Relaciones institucionales</p>
        <h2 class="text-section-title">
          Conversemos sobre tu propuesta
        </h2>
        <p class="mt-6 text-body text-text-secondary">
          En IMB Institute creemos en el valor de las alianzas estratégicas para desarrollar capacidades en sectores como minería, construcción y tecnología. Cuéntanos sobre tu proyecto para que nuestro equipo de Relaciones Institucionales revise la propuesta y evalúe una posible colaboración.
        </p>
      </div>

      <Card class="rounded-xl! p-8 shadow-none! hover:shadow-none! lg:col-span-7 lg:p-12">
        <div class="mb-10 border-b border-border-subtle pb-8">
          <h2 class="text-component-title">Comparte los datos de tu propuesta</h2>
          <p class="mt-3 text-meta text-text-secondary">
            Nuestro equipo revisará la información de tu organización y se comunicará contigo mediante los datos proporcionados.
          </p>
        </div>
        <FormAlianzas />
      </Card>
    </div>
  </Wrapper>
</BaseLayout>
