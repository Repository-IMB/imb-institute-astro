---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/ui/Card.astro';
import Wrapper from '../../components/ui/Wrapper.astro';
import Accordion from '../../components/ui/Accordion.astro';
import FormAsesor from '../../components/forms/FormAsesor.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { cursos, type Curso } from '../../data/cursos';
import { Clock, Calendar, FileText } from 'lucide-astro';
import { ROUTES, COURSE_ROUTES } from '../../config/routes';
import Badge from '../../components/ui/Badge.astro';

export const prerender = true;

export function getStaticPaths() {
  return cursos.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

interface Props {
  course: Curso;
}

const { course } = Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const courseUrl = new URL(COURSE_ROUTES.DETAIL(course.slug), siteUrl).href;
const catalogUrl = new URL(ROUTES.CAPACITACION, siteUrl).href;
const homeUrl = new URL(ROUTES.HOME, siteUrl).href;

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': `${courseUrl}#course`,
  name: course.nombre,
  description: course.descripcion,
  image: course.imagen,
  provider: {
    '@type': 'Organization',
    name: 'IMB Institute',
    url: homeUrl,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Capacitación', item: catalogUrl },
    { '@type': 'ListItem', position: 3, name: course.nombre, item: courseUrl },
  ],
};
---

<BaseLayout
  title={`${course.nombre} | IMB Institute`}
  description={course.descripcion}
  image={course.imagen}
  structuredData={[courseSchema, breadcrumbSchema]}
>

  <Wrapper class="relative overflow-x-clip" padded={false}>
    <Breadcrumb
      class="pt-8 lg:pt-10"
      items={[
        { label: 'Inicio', href: ROUTES.HOME },
        { label: 'Capacitación', href: ROUTES.CAPACITACION },
        { label: course.nombre },
      ]}
    />
    <div class="grid lg:grid-cols-3 gap-12 lg:gap-16 items-start relative">
      <!-- FIRST COLUMN: Main content flow -->
      <div class="lg:col-span-2">
        <!-- SECTION 1: Course Header Info -->
        <div class="relative py-12 lg:py-20">
          <!-- Full-width breakout background (White) -->
          <div class="absolute inset-y-0 left-[-100vw] right-[-100vw] bg-surface-0 z-0 shadow-sm border-b border-border-subtle/30"></div>

          <div class="relative z-10">
            <div class="mb-4">
              <Badge variant={course.estado === 'Activo' ? 'success' : 'warning'}>
                {course.estado}
              </Badge>
            </div>
            <h1 class="mb-6 text-page-title">{course.nombre}</h1>
            <p class="mb-10 text-lead text-text-secondary">{course.descripcion}</p>

            <div class="flex flex-wrap items-center gap-8 lg:gap-12">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-imb/5 flex items-center justify-center">
                  <Clock size={20} class="text-imb" />
                </div>
                <div>
                  <p class="text-label uppercase tracking-widest text-text-secondary">Duración</p>
                  <h4 class="text-body-title">{course.duracion}</h4>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-imb/5 flex items-center justify-center">
                  <Calendar size={20} class="text-imb" />
                </div>
                <div>
                  <p class="text-label uppercase tracking-widest text-text-secondary">Inicio y Fin</p>
                  <h4 class="text-body-title">{course.fechaInicio} / {course.fechaFin}</h4>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-imb/5 flex items-center justify-center">
                  <FileText size={20} class="text-imb" />
                </div>
                <div>
                  <p class="text-label uppercase tracking-widest text-text-secondary">Certificación</p>
                  <h4 class="text-body-title">{course.certificacion}</h4>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 2: Course Details & Curriculum -->
        <div class="relative py-16 lg:py-24 space-y-20">
          <!-- Full-width breakout background (Surface 50) -->
          <div class="absolute inset-y-0 left-[100vw] -right-[100vw] bg-surface-50 z-0"></div>

          <div class="relative z-10 space-y-20">
            <!-- About Section -->
            <section>
              <h2 class="mb-6 text-section-title">Acerca del programa</h2>
              <div class="prose prose-lg text-text-secondary max-w-none leading-relaxed space-y-6">
                <p>{course.descripcion}</p>
              </div>
            </section>

            <!-- Curriculum Section -->
            <section>
              <div class="mb-10">
                <h2 class="mb-2 text-section-title">Plan de Estudios</h2>
                <p class="font-sans text-text-secondary">Explora los módulos y temas que desarrollaremos a lo largo del programa.</p>
              </div>
              <div class="space-y-4">
                {course.modulos.map((modulo, i) => (
                  <Accordion title={modulo.titulo} isOpen={i === 0}>
                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 py-2">
                      {modulo.items.map(item => (
                        <li class="flex items-start gap-2 text-text-secondary font-sans text-sm">
                          <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-imb shrink-0"></div>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </Accordion>
                ))}
              </div>
            </section>
          </div>
        </div>
      </div>

      <!-- SECOND COLUMN: Sticky Sidebar Form -->
      <aside class="lg:col-span-1 h-full py-12 lg:py-16">
        <div class="sticky top-28 z-20">
          <Card class="rounded-3xl p-8 lg:p-10 shadow-premium border border-border-subtle/20 bg-surface-0">
            <div class="mb-8">
              <h3 class="mb-2 text-component-title">Contactar a un Asesor</h3>
              <p class="text-meta text-text-secondary">Déjanos tus datos para enviarte el brochure detallado y el cronograma del programa.</p>
            </div>
            <FormAsesor cursoNombre={course.nombre} />
          </Card>
        </div>
      </aside>
    </div>
  </Wrapper>
</BaseLayout>
