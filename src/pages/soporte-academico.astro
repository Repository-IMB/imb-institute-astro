---
import BaseLayout from '../layouts/BaseLayout.astro';
import Accordion from '../components/ui/Accordion.astro';
import Card from '../components/ui/Card.astro';
import Wrapper from '../components/ui/Wrapper.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import FormSoporte from '../components/forms/FormSoporte.astro';
import soporteHero from '../assets/images/soporte-hero.webp';

export const prerender = true;

const faqs = [
  {
    pregunta: '¿Cómo ingreso a las sesiones en vivo?',
    respuesta: 'Recibirás un correo electrónico 24 horas antes del inicio con el enlace directo de Zoom o Google Meet. También puedes encontrar el enlace en la pestaña "Sesiones" dentro de tu Aula Virtual.'
  },
  {
    pregunta: '¿Cómo ingreso a la plataforma virtual?',
    respuesta: 'Al matricularte, te enviaremos tus credenciales de acceso al correo registrado. Ve a la opción "Iniciar Sesión" en nuestra web e ingresa tu usuario y contraseña.'
  },
  {
    pregunta: '¿Las sesiones en vivo se graban? ¿Cómo puedo verlas?',
    respuesta: 'Sí, todas las sesiones quedan grabadas y se suben a la plataforma dentro de las siguientes 24 horas para que puedas repasarlas a tu ritmo.'
  },
  {
    pregunta: '¿No veo mi curso en el aula virtual?',
    respuesta: 'En el aula virtual, los módulos del curso se van agregando progresivamente conforme se desarrollan las sesiones. Al finalizar el primer módulo y pasar la semana de pausa, se activará el segundo módulo de forma automática.'
  }
];
---

<BaseLayout
  title="Soporte académico | IMB Institute"
  description="Consulta las preguntas frecuentes o envía una solicitud al equipo de soporte académico de IMB Institute."
  image={soporteHero}
>
  <HeroSection
    title="¿Necesitas ayuda con tu curso?"
    description="Cuéntanos qué sucede y te responderemos a la brevedad (en un máximo de 24 a 48 hrs hábiles)."
    image={soporteHero}
    />

  <Wrapper class="bg-surface-50 py-20 lg:py-28" padded={false}>
    <div class="grid items-start gap-14 lg:grid-cols-12 lg:gap-16">
      <section class="lg:col-span-7">
        <p class="mb-4 text-label uppercase tracking-widest text-imb">Ayuda rápida</p>
        <h2 class="text-section-title">Preguntas frecuentes</h2>
        <p class="mt-5 max-w-2xl leading-relaxed text-text-secondary">
          Aquí encontrarás información sobre las sesiones, el acceso al aula virtual y la publicación de contenidos.
        </p>
        <div class="mt-10 space-y-4">
          {faqs.map((faq, index) => (
            <Accordion title={faq.pregunta} isOpen={index === 0}>
              <p class="leading-relaxed text-text-secondary">{faq.respuesta}</p>
            </Accordion>
          ))}
        </div>
      </section>

      <Card class="rounded-xl! p-8 shadow-none! hover:shadow-none! lg:col-span-5 lg:sticky lg:top-28 lg:p-10">
        <div class="mb-8 border-b border-border-subtle pb-7">
          <h2 class="text-component-title">Cuéntanos qué problema tienes</h2>
          <p class="mt-3 text-meta text-text-secondary">
            Incluye los datos del curso y una descripción breve para que podamos revisar tu caso.
          </p>
        </div>
        <FormSoporte />
      </Card>
    </div>
  </Wrapper>
</BaseLayout>
