---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wrapper from '../components/ui/Wrapper.astro';
import Card from '../components/ui/Card.astro';
import SwiperCarousel from '../components/ui/SwiperCarousel.astro';
import FormStaff from '../components/forms/FormStaff.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import MediaImage from '../components/ui/MediaImage.astro';
import TestimonialCard from '../components/ui/TestimonialCard.astro';
import { Briefcase, GraduationCap, Globe, FileText } from 'lucide-astro';

export const prerender = true;

const stats = [
  {
    icon: Briefcase,
    number: "47",
    label: "Profesionales con trayectoria comprobada en entornos empresariales"
  },
  {
    icon: GraduationCap,
    number: "97%",
    label: "Cuenta con formación de posgrado y especialización en sus áreas"
  },
  {
    icon: Globe,
    number: "12+",
    label: "Países donde nuestro staff aporta experiencia y visión global"
  }
];

const staff = [
  {
    name: "Juan David Cortés",
