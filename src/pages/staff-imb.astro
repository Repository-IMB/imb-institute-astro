    ]
  },
  {
    name: "Carlos Romero Gave",
    role: "Ingeniero - Perú",
    imgUrl: "https://epsanfrancisco.com/wp-content/uploads/image/2026/04/gonzalo-herrera/Carlos-romero-Gave-2.png",
