const testimonials = [
  {
    quote: "En IMB Institute encontré un espacio donde me permite potenciar mis habilidades estratégicas. Agradezco la autonomía y la confianza para llevar adelante nuevos proyectos.",
    author: "Constanza Costa",
    country: "Argentina",
    area: "Growth"
  },
  {
    quote: "El nivel académico y el enfoque práctico de IMB superaron todas mis expectativas. Es inspirador trabajar con profesionales tan apasionados.",
    author: "Carlos Martínez",
    country: "Colombia",
    area: "Gestión de Proyectos"
  },
  {
    quote: "Una excelente oportunidad para hacer networking con expertos de toda Latinoamérica y potenciar mi perfil profesional a nivel internacional.",
    author: "Andrea Salazar",
    country: "México",
    area: "Finanzas Corporativas"
  }
];
---

<BaseLayout 
  title="Staff de profesionales | IMB Institute"
  description="Conoce la experiencia académica y profesional del equipo que participa en los programas de IMB Institute."
>
  <HeroSection
    title="Staff de profesionales de confianza de IMB"
    highlight="confianza"
    description="Un equipo de expertos con trayectoria comprobada que combina calidad, excelencia académica y experiencia empresarial en toda América Latina dentro de IMB Institute."
    image="/images/colleagues-working-together-project.webp"
  />

  <Wrapper class="border-b border-border-subtle bg-surface-0 py-12 lg:py-16" padded={false}>
    <div class="grid gap-6 md:grid-cols-3">
      {stats.map((s) => (
        <Card class="flex items-start gap-5 rounded-xl! p-6 shadow-none! hover:shadow-none! lg:p-8">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-surface-50 text-imb" aria-hidden="true">
            <s.icon size={23} />
          </div>
          <div>
            <p class="font-display text-stat text-text-primary">{s.number}</p>
            <p class="mt-3 text-meta text-text-secondary">{s.label}</p>
          </div>
        </Card>
      ))}
    </div>
  </Wrapper>

  <Wrapper class="bg-surface-50 py-24 lg:py-32" padded={false}>
    <div class="mb-14 max-w-3xl">
      <h2 class="text-section-title">
        Integrantes del Staff que te acompañan en cada paso
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {staff.map((member) => (
        <button
          type="button"
          class="imb-card-equipo-container group w-full cursor-pointer appearance-none bg-transparent p-0 text-left focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-imb"
          data-staff-card
          data-member={member.name}
          aria-label={`Ver trayectoria de ${member.name}`}
          aria-pressed="false"
        >
          <span class="imb-card-equipo-inner">
            <span class="imb-card-equipo-front border border-border-subtle shadow-premium">
              <span class="relative flex h-80 w-full items-end justify-center overflow-hidden bg-linear-to-b from-surface-100 to-surface-50">
                <span class="absolute bottom-4 left-1/2 -z-1 h-56 w-56 -translate-x-1/2 rounded-full bg-imb/5 blur-lg" aria-hidden="true"></span>
                <MediaImage
                  src={member.imgUrl}
                  alt={member.name}
                  class="h-[90%] object-contain drop-shadow-md transition-transform duration-500 group-hover:scale-105"
                  width={480}
                  height={600}
                  loading="lazy"
                />
              </span>
              <span class="relative border-t border-border-muted bg-surface-0 p-6 text-center">
                <span class="block line-clamp-1 font-display text-item-title">{member.name}</span>
                <span class="mt-1 block line-clamp-1 text-xs font-semibold uppercase tracking-wide text-imb">{member.role.split(' - ')[0]}</span>
                <span class="mt-1 block text-caption text-text-secondary">{member.role.includes(' - ') ? member.role.split(' - ')[1] : ''}</span>
              </span>
            </span>

            <span class="imb-card-equipo-back flex flex-col justify-between border border-imb/20 bg-surface-0 p-6 shadow-premium">
              <span>
                <span class="block text-center font-display text-card-title text-imb">{member.name}</span>
                <span class="mb-4 mt-1 block border-b border-border-subtle pb-3 text-center text-sm font-bold text-text-primary">{member.role}</span>
                <span class="custom-scrollbar block max-h-64 space-y-3 overflow-y-auto pr-1">
                {member.bios.map((paragraph) => (
                    <span class="block text-left text-sm leading-relaxed text-text-secondary">
                      • {paragraph}
                    </span>
                ))}
                </span>
              </span>
              <span class="pt-4 text-center text-label uppercase tracking-wider text-imb">
                Trayectoria IMB
              </span>
            </span>
          </span>
        </button>
      ))}
    </div>
  </Wrapper>

  <Wrapper class="relative overflow-hidden border-y border-border-subtle bg-surface-0 py-20 lg:py-28" full>
    <div class="relative z-10 max-w-6xl mx-auto px-6">
      <div class="mb-12 text-center">
        <h2 class="text-section-title">Testimonios del Staff IMB</h2>
      </div>

      <div class="max-w-3xl mx-auto">
        <SwiperCarousel
          slidesPerView={1}
          spaceBetween={24}
          autoplay={{ delay: 6000, disableOnInteraction: true }}
        >
          {testimonials.map((testimonial) => (
            <swiper-slide class="h-auto">
              <TestimonialCard
                quote={testimonial.quote}
                author={`${testimonial.author} - ${testimonial.country}`}
                role={testimonial.area}
                class="h-full"
              />
            </swiper-slide>
          ))}
        </SwiperCarousel>
      </div>
    </div>
  </Wrapper>

  <Wrapper id="formulario" class="bg-surface-50 py-20 lg:py-28" padded={false}>
    <div class="max-w-xl mx-auto">
      <Card class="rounded-xl! p-8 shadow-none! hover:shadow-none! lg:p-12">
        <div class="text-center mb-10">
          <div class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-surface-50 text-imb" aria-hidden="true">
            <FileText size={23} />
          </div>
          <h2 class="text-component-title">Postula al staff de IMB</h2>
          <p class="text-meta text-text-secondary">
            Envíanos tus datos y currículum para revisar tu perfil profesional.
          </p>
        </div>

        <FormStaff />
      </Card>
    </div>
  </Wrapper>

</BaseLayout>

<style>
  .imb-card-equipo-container {
    height: 440px;
    perspective: 1000px;
  }

  .imb-card-equipo-inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    text-align: center;
    transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (hover: hover) {
    .imb-card-equipo-container:hover .imb-card-equipo-inner {
      transform: rotateY(180deg);
    }
  }

  .imb-card-equipo-container.is-flipped .imb-card-equipo-inner {
    transform: rotateY(180deg);
  }

  .imb-card-equipo-front,
  .imb-card-equipo-back {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 1.5rem;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .imb-card-equipo-front {
    z-index: 2;
    display: flex;
    flex-direction: column;
  }

  .imb-card-equipo-back {
    z-index: 1;
    transform: rotateY(180deg);
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: var(--color-border-subtle);
    border-radius: 2px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: var(--color-imb);
  }

  @media (prefers-reduced-motion: reduce) {
    .imb-card-equipo-inner {
      transition: none;
    }
  }
</style>

<script>
  function initStaffCards() {
    document.querySelectorAll<HTMLButtonElement>('[data-staff-card]').forEach((card) => {
      if (card.dataset.initialized) return;
      card.dataset.initialized = 'true';

      card.addEventListener('click', () => {
        const isFlipped = card.classList.toggle('is-flipped');
        const member = card.dataset.member || '';
        card.setAttribute('aria-pressed', String(isFlipped));
        card.setAttribute('aria-label', `${isFlipped ? 'Ocultar' : 'Ver'} trayectoria de ${member}`);
      });
    });
  }

  document.addEventListener('astro:page-load', initStaffCards);
  initStaffCards();
</script>
