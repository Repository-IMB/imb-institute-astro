    imgUrl: "https://epsanfrancisco.com/wp-content/uploads/image/2026/04/gonzalo-herrera/DAVID_Cortes-removebg-preview.png",
    bios: [
      "Profesional de la salud con experiencia integral en roles asistenciales, académicos y comerciales, destacado por integrar IA y análisis de datos.",
      "Maestría en Salud Pública y formación en epidemiología, bioestadística y programación.",
      "Experiencia en UCI, gestión hospitalaria y desarrollo comercial en Sanitas."
    ]
  },
  {
    name: "Gustavo C. Cerezo",
    role: "Gerente Financiero y Contable - México",
    imgUrl: "https://epsanfrancisco.com/wp-content/uploads/image/2026/04/gonzalo-herrera/Retrato-de-hombre-elegante-y-confiado.png",
    bios: [
      "Gerente de Finanzas y Control Interno con más de 15 años de experiencia en auditoría, riesgos y cumplimiento.",
      "Contador con Maestría en Contabilidad Internacional y certificaciones en auditoría interna.",
      "Ha ocupado roles clave en PwC, Konfío y RSM."
    ]
  },
  {
    name: "Gerardo García",
    role: "Finanzas - México",
    imgUrl: "https://epsanfrancisco.com/wp-content/uploads/image/2026/04/gonzalo-herrera/mag-gerardo-finanzas.png",
    bios: [
      "Licenciado en Finanzas con más de 10 años de experiencia en análisis de datos.",
      "Máster en Finanzas Cuantitativas, experto en machine learning, Power BI y análisis macroeconómico.",
      "Ha ocupado roles clave en Hewlett Packard Enterprise, Aruba y URREA."
    ]
  },
  {
    name: "Sebastián Jazme",
    role: "Magister de Mantenimiento - Chile",
    imgUrl: "https://epsanfrancisco.com/wp-content/uploads/image/2026/04/gonzalo-herrera/Foto-Docente-Sebastian-Jazme.jpg",
    bios: [
      "Consultor experto en metodologías Kaizen, TPS, TPM y Lean Six Sigma.",
      "Certificado internacional en TPM en Japón, Green Belt Lean Six Sigma y Auditor ISO 9001.",
      "Más de 20.000 horas de capacitación a 10.000 profesionales."
    ]
  },
  {
    name: "Arturo Mora",
    role: "Licenciado en Economía - México",
    imgUrl: "https://epsanfrancisco.com/wp-content/uploads/image/2026/04/gonzalo-herrera/4d88da79-5c14-4537-8861-b81fa6545db0.png",
    bios: [
      "Más de 10 años de experiencia como Product Manager en banca, salud, e-commerce y contabilidad.",
      "Lidera estrategia de canales digitales en Scotiabank México.",
      "Ha ocupado roles como Senior Product Manager y Product Owner."
    ]
  },
  {
    name: "Alejandra Victoria Inzunza",
    role: "Gerente Financiera y Contable - México",
    imgUrl: "https://epsanfrancisco.com/wp-content/uploads/image/2026/04/gonzalo-herrera/alejandra-victoria-insunza-1.png",
    bios: [
      "Más de 17 años de experiencia en finanzas corporativas.",
      "Especialista en análisis financiero, control presupuestario y gestión contable.",
